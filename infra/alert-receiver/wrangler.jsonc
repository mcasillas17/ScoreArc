{
  "name": "scorearc-alert-receiver",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  // Every five minutes D1 selects the monitor producer. The missed-heartbeat
  // alarm runs in every mode, including an operator handoff.
  "triggers": { "crons": ["*/5 * * * *"] },
  // The hosted reader checks took hundreds of milliseconds of CPU. Pin the
  // paid plan's five-minute-cron allowance so deployment verifies eligibility.
  "limits": { "cpu_ms": 30000 },
  // Request URLs contain the receiver token, so invocation logs stay off. Only the
  // Worker's own sanitized failure lines are kept.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // No recipient here: this repository is public. RECEIVER_TOKEN, ALERT_RECIPIENT and
  // GITHUB_DISPATCH_TOKEN are Worker secrets. The sending domain is deliberately not onboarded, so this
  // binding can reach verified destination addresses only.
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "scorearc-alert-receiver",
    "database_id": "31dcc498-699d-42ff-a051-f10e1534d0b5",
    "migrations_dir": "migrations"
  }]
}
