{
  "name": "scorearc-match-freshness-shadow",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "SHADOW_DB",
    "database_name": "scorearc-match-freshness-shadow",
    "migrations_dir": "migrations"
  }]
}
