# ScoreArc backend — environment template.
#
# Copy this to `backend/.env` and fill in the REAL values there.
# `backend/.env` is gitignored (by backend/.gitignore `*.env` AND root .gitignore
# `.env*`) — it is NEVER committed. This .example file holds placeholders ONLY.
# In production these do NOT live in a file: set them as Fly secrets
# (`fly secrets set ...`) / Vercel env vars.

# Neon Postgres (from Vercel → Storage → your DB → Connection Details)
DIRECT_DSN='postgres://<user>:<pass>@<direct-host>/<db>?sslmode=require'   # unpooled — migrations
POOLED_DSN='postgres://<user>:<pass>@<pooled-host>/<db>?sslmode=require'   # pooled  — the app/services

# Cloudflare R2 (logo mirror) — from the R2 API token you create in the dashboard
R2_ACCOUNT_ID='<account-id>'
R2_ACCESS_KEY_ID='<access-key-id>'
R2_SECRET_ACCESS_KEY='<secret-access-key>'
R2_BUCKET='scorearc-assets'
